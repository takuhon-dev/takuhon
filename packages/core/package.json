{
  "name": "@takuhon/core",
  "version": "1.1.0",
  "description": "JSON Schema, validation, normalization, locale resolution, and JSON-LD generation for takuhon",
  "license": "Apache-2.0",
  "author": "Takuhon contributors",
  "homepage": "https://github.com/takuhon-dev/takuhon/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takuhon-dev/takuhon.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/takuhon-dev/takuhon/issues"
  },
  "keywords": [
    "takuhon",
    "profile",
    "json-schema",
    "json-ld",
    "portable",
    "self-hosted"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.json": "./takuhon.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "takuhon.schema.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc",
    "generate": "node scripts/generate-validator.mjs",
    "prebuild": "node scripts/generate-validator.mjs",
    "build": "tsup"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
