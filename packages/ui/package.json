{
  "name": "@meport/ui",
  "version": "0.0.0",
  "description": "React mobile-first profile UI and minimal admin editor components for meport",
  "license": "MIT",
  "author": "meport contributors",
  "homepage": "https://github.com/takashi-matsuyama/meport/tree/main/packages/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takashi-matsuyama/meport.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/takashi-matsuyama/meport/issues"
  },
  "keywords": [
    "meport",
    "profile",
    "ui",
    "react",
    "mobile-first"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
