{
  "name": "@meport/ui",
  "version": "0.0.0",
  "description": "React mobile-first profile UI and minimal admin editor components for meport",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc",
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap"
  },
  "dependencies": {
    "@meport/core": "workspace:*"
  }
}
