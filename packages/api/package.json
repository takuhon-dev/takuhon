{
  "name": "@takuhon/api",
  "version": "0.1.0",
  "description": "Hono-based HTTP handlers, RFC 7807 error envelope, and response builders for ownport",
  "license": "MIT",
  "author": "ownport contributors",
  "homepage": "https://github.com/ownport-dev/ownport/tree/main/packages/api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ownport-dev/ownport.git",
    "directory": "packages/api"
  },
  "bugs": {
    "url": "https://github.com/ownport-dev/ownport/issues"
  },
  "keywords": [
    "ownport",
    "profile",
    "api",
    "hono",
    "cloudflare-workers"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc",
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "test": "vitest run"
  },
  "dependencies": {
    "@takuhon/core": "workspace:*",
    "hono": "^4.12.19"
  }
}
