{
  "name": "@takuhon/cli",
  "version": "1.4.1",
  "description": "create-takuhon scaffolding plus dev/validate/sync/export/migrate/restore commands",
  "license": "Apache-2.0",
  "author": "Takuhon contributors",
  "homepage": "https://github.com/takuhon-dev/takuhon/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takuhon-dev/takuhon.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/takuhon-dev/takuhon/issues"
  },
  "keywords": [
    "takuhon",
    "profile",
    "cli",
    "create-takuhon",
    "scaffolding"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./init": {
      "types": "./dist/init.d.ts",
      "import": "./dist/init.js"
    }
  },
  "bin": {
    "takuhon": "./dist/index.js",
    "create-takuhon": "./dist/init.js"
  },
  "files": [
    "dist",
    "admin-bundle",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc",
    "build": "tsup src/index.ts src/init.ts --format esm --dts --clean --sourcemap && node scripts/copy-admin-bundle.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@hono/node-server": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@takuhon/activity": "workspace:*",
    "@takuhon/api": "workspace:*",
    "@takuhon/core": "workspace:*",
    "@takuhon/mcp": "workspace:*",
    "hono": "^4.12.25"
  },
  "devDependencies": {
    "@takuhon/admin": "workspace:*"
  }
}
