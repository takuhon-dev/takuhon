{
  "name": "@meport/cli",
  "version": "0.0.0",
  "description": "create-meport scaffolding plus dev/validate/sync/export/migrate/restore commands",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "meport": "./dist/index.js",
    "create-meport": "./dist/init.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/init.ts --format esm --dts --clean --sourcemap"
  },
  "dependencies": {
    "@meport/core": "workspace:*"
  }
}
